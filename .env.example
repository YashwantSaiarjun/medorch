# ---------------------------------------------------------------------------
# MedOrch environment configuration
# Copy this file to .env and fill in real values. Never commit a real .env.
# ---------------------------------------------------------------------------

# LLM provider used for intent classification & answer synthesis.
# Supported: anthropic | openai
LLM_PROVIDER=anthropic

# API key for the configured provider. Leave blank to run MedOrch fully
# offline with deterministic heuristic intent classification and
# template-based answers (useful for CI / demos without credentials).
LLM_API_KEY=

# Model name for the configured provider.
LLM_MODEL=claude-sonnet-4-6

# Set to "true" to force MedOrch to skip LLM calls entirely, even if
# LLM_API_KEY is set.
DISABLE_LLM=false

# PostgreSQL + pgvector connection string. Leave unset to use the built-in
# in-memory vector store instead (no infrastructure required for a quick
# local run). Set this to use docker-compose's postgres service:
#   postgresql+psycopg2://medorch:medorch@localhost:5432/medorch
DATABASE_URL=

# App behaviour
APP_ENV=development
LOG_LEVEL=INFO
RETRIEVAL_TOP_K=3

# Streamlit -> FastAPI backend URL
MEDORCH_API_URL=http://localhost:8000
